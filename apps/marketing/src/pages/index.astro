---
import Layout from "../layouts/Layout.astro";
import {
  AGENTBOX_URL,
  CHECKSUMS_FILE,
  DESKTOP_ASSETS,
  GITHUB_URL,
  INSTALL_PS1,
  INSTALL_SH,
  RELEASES_URL,
  SERVER_ASSETS,
  VERSION,
  assetUrl,
} from "../lib/site";

const platformDefaults = {
  linux: assetUrl("K-code-linux-x86_64.AppImage"),
  windows: assetUrl("K-code-windows-x64-setup.exe"),
  "macos-arm64": assetUrl("K-code-macos-arm64.dmg"),
  "macos-x64": assetUrl("K-code-macos-x64.dmg"),
};

const features = [
  {
    kicker: "Providers",
    title: "Every agent, one app",
    body: "Claude Code, Codex, Cursor, OpenCode, Pi, Antigravity and Oh My Pi side by side. Bring the subscriptions you already pay for; K-code drives the CLIs you have installed.",
  },
  {
    kicker: "Agent Hub",
    title: "See every running agent",
    body: "A live grid of all subagents in a thread, or across a whole project. Current tool, progress, latest thinking and replies at a glance, with a per-agent Stop where the provider supports it.",
  },
  {
    kicker: "Transcript",
    title: "Full transcript mode",
    body: "Flip one switch to expand every turn: complete thinking, full tool input and output, no collapsed work groups and no truncated logs. Desktop, web and mobile.",
  },
  {
    kicker: "Sessions",
    title: "Resume native sessions",
    body: "Pick up Oh My Pi sessions you started in the terminal, from this project or any other. Titles match what omp shows, and renames flow back to the session.",
  },
  {
    kicker: "Remote",
    title: "Your desk, from your phone",
    body: "Run K-code on a workstation or VPS and drive it from a browser or the mobile app over LAN, Tailscale or a Cloudflare tunnel, with one-time pairing links.",
  },
  {
    kicker: "Sync",
    title: "Settings that follow you",
    body: "Appearance and most preferences sync across every device connected to the same server. Fonts and window chrome stay per device.",
  },
  {
    kicker: "Open",
    title: "Open source, MIT",
    body: "No account and no subscription. K-code is a community fork of T3 Code and stays MIT licensed. Read it, fork it, self-host it.",
  },
];
---

<Layout path="/">
  <main>
    <section class="hero">
      <div class="wrap">
        <img class="hero-logo" src="/brand/kcode-mark.svg" alt="K-code logo" width="96" height="96" />
        <h1>The open <span class="grad-text">GUI</span> for your coding agents.</h1>
        <p class="sub">
          Run Claude Code, Codex, Cursor, Oh My Pi, OpenCode and more from one fast app: on desktop, in the
          browser, or from your phone.
        </p>
        <div class="hero-cta">
          <a
            class="btn btn-primary"
            id="download-primary"
            href="#downloads"
            data-assets={JSON.stringify(platformDefaults)}>Download</a
          >
          <a class="btn" href="/docs/introduction/">Read the docs</a>
        </div>
        <p class="hero-meta" id="download-meta">v{VERSION} · Linux, Windows, macOS · MIT</p>
        <div class="cmd-block">
          <h2>Install with one command</h2>
          <div class="cmd">
            <span class="tag">Linux<br />macOS</span><code>{INSTALL_SH}</code>
            <button class="btn btn-sm" type="button" data-copy={INSTALL_SH}>Copy</button>
          </div>
          <div class="cmd">
            <span class="tag">Windows</span><code>{INSTALL_PS1}</code>
            <button class="btn btn-sm" type="button" data-copy={INSTALL_PS1}>Copy</button>
          </div>
        </div>
      </div>
    </section>

    <section class="block" id="features">
      <div class="wrap">
        <h2 class="title">Built for people who run several agents</h2>
        <p class="lead">
          K-code sits on top of the agent CLIs you already trust and gives them one fast, consistent
          interface.
        </p>
        <div class="grid">
          {
            features.map((f) => (
              <div class="card">
                <span class="kicker">{f.kicker}</span>
                <h3>{f.title}</h3>
                <p>{f.body}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="block" id="agent-hub">
      <div class="wrap">
        <h2 class="title">Agent Hub: a grid of running agents</h2>
        <p class="lead">
          When an agent fans out into subagents, every one gets its own pane with status, current tool and
          live output. The project-wide page shows all live agents across threads, grouped by parent
          thread. Stop an individual agent when the provider can cancel it, or stop the whole turn.
        </p>
        <div class="agents-mock" aria-hidden="true">
          <div class="pane">
            <header>agent 1 of 3 <span class="state">● running</span></header>
            <div class="line">$ rg "TODO" apps/server</div>
            <div class="line">reading 14 files…</div>
            <button class="stop" tabindex="-1">Stop</button>
          </div>
          <div class="pane">
            <header>agent 2 of 3 <span class="state">● running</span></header>
            <div class="line">edit src/session/resume.ts</div>
            <div class="line">thinking: titles come from…</div>
            <button class="stop" tabindex="-1">Stop</button>
          </div>
          <div class="pane">
            <header>agent 3 of 3 <span class="state" style="color: var(--mist)">✓ done</span></header>
            <div class="line">Summary written, 3 files</div>
            <div class="line">18.2k tokens</div>
          </div>
        </div>
      </div>
    </section>

    <section class="block" id="downloads">
      <div class="wrap">
        <h2 class="title">Download K-code v{VERSION}</h2>
        <p class="lead">
          Links point at the latest GitHub release. macOS builds are unsigned: right-click, Open the first
          time.
        </p>
        <div class="dl-cols">
          <div>
            <h3>Desktop app</h3>
            <ul class="dl-list">
              {
                DESKTOP_ASSETS.map((a) => (
                  <li>
                    <a href={assetUrl(a.file)} data-platform={a.platform}>
                      <span>
                        <strong>{a.label}</strong>
                        {a.note && <span class="muted"> · {a.note}</span>}
                        <br /><small>{a.file}</small>
                      </span>
                      <span>↓</span>
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
          <div>
            <h3>Server / CLI (headless)</h3>
            <ul class="dl-list">
              {
                SERVER_ASSETS.map((a) => (
                  <li>
                    <a href={assetUrl(a.file)}>
                      <span>
                        <strong>{a.label}</strong><br /><small>{a.file}</small>
                      </span>
                      <span>↓</span>
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
        <p class="muted" style="margin-top: 1.5rem">
          Verify downloads with <a href={assetUrl(CHECKSUMS_FILE)}>{CHECKSUMS_FILE}</a>. Older versions and
          release notes: <a href={RELEASES_URL} rel="noopener">all releases</a>. Prefer a package script? Use
          the one-line installers above, or see
          <a href="/docs/install/">the install guide</a>.
        </p>
      </div>
    </section>

    <section class="block" id="agentbox">
      <div class="wrap">
        <h2 class="title">Part of AgentBox</h2>
        <p class="lead">
          K-code belongs to the <a href={AGENTBOX_URL} rel="noopener">AgentBox</a> family: private, always-on
          workspaces for coding agents. Run K-code inside an AgentBox workspace and reach it from anywhere,
          or run it on your own machine. Either way it is the same app.
        </p>
        <a class="btn" href={AGENTBOX_URL} rel="noopener">Visit agentbox.io.vn</a>
        <a class="btn" href={GITHUB_URL} rel="noopener">Star on GitHub</a>
      </div>
    </section>
  </main>

  <script>
    const primary = document.getElementById("download-primary") as HTMLAnchorElement | null;
    const meta = document.getElementById("download-meta");
    if (primary) {
      const urls = JSON.parse(primary.dataset.assets ?? "{}") as Record<string, string>;
      const ua = navigator.userAgent;
      let key: string | undefined;
      let label = "";
      if (/Windows/i.test(ua)) {
        key = "windows";
        label = "Windows";
      } else if (/Macintosh|Mac OS X/i.test(ua) && !/iPhone|iPad/i.test(ua)) {
        // Apple Silicon is indistinguishable from Intel in the UA; default to Apple Silicon.
        key = "macos-arm64";
        label = "macOS (Apple Silicon)";
      } else if (/Linux|X11/i.test(ua) && !/Android/i.test(ua)) {
        key = "linux";
        label = "Linux";
      }
      const url = key ? urls[key] : undefined;
      if (url) {
        primary.href = url;
        primary.textContent = `Download for ${label}`;
        if (meta) meta.textContent += " · other platforms below";
      }
    }
    document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((button) => {
      button.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(button.dataset.copy ?? "");
          button.textContent = "Copied";
          setTimeout(() => (button.textContent = "Copy"), 1500);
        } catch {
          // Clipboard unavailable: leave the command selectable.
        }
      });
    });
  </script>
</Layout>
