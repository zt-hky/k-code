---
import "../styles/site.css";
import { AGENTBOX_URL, GITHUB_URL, SITE_URL } from "../lib/site";

interface Props {
  title?: string;
  description?: string;
  path?: string;
}

const {
  title = "K-code: the open GUI for your coding agents",
  description = "Run Claude Code, Codex, Cursor, Oh My Pi, OpenCode and more from one fast app, on desktop, in the browser, or from your phone.",
  path = Astro.url.pathname,
} = Astro.props;
const canonical = new URL(path, SITE_URL).toString();
const section = path.startsWith("/docs") ? "docs" : path.startsWith("/download") ? "download" : "home";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#05080D" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${SITE_URL}/og.png`} />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/">
          <img src="/brand/kcode-mark.svg" alt="" width="28" height="28" />
          K-code
        </a>
        <nav class="site-nav" aria-label="Primary">
          <a href="/#features" class="hide-sm">Features</a>
          <a href="/docs/introduction/" aria-current={section === "docs" ? "page" : undefined}>Docs</a>
          <a href="/#downloads" aria-current={section === "download" ? "page" : undefined}>Download</a>
          <a href={GITHUB_URL} rel="noopener">GitHub</a>
        </nav>
      </div>
    </header>
    <slot />
    <footer class="site-footer">
      <div class="wrap">
        <div>
          <strong style="color: var(--foam)">K-code</strong>: MIT licensed. Based on
          <a href="https://github.com/pingdotgg/t3code" rel="noopener">T3 Code</a> by Ping Labs.<br />
          Part of <a href={AGENTBOX_URL} rel="noopener">AgentBox</a>.
        </div>
        <nav aria-label="Footer">
          <a href="/docs/introduction/">Docs</a>
          <a href="/docs/changelog/">Changelog</a>
          <a href={`${GITHUB_URL}/releases`} rel="noopener">Releases</a>
          <a href={GITHUB_URL} rel="noopener">GitHub</a>
          <a href={`${GITHUB_URL}/issues`} rel="noopener">Issues</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
